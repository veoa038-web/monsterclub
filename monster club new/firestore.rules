rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Packages: Anyone can view, Authenticated (Admin) can create/update/delete
    match /packages/{packageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Photo Gallery: Anyone can view, Authenticated (Admin) can upload/delete
    match /gallery_photos/{photoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Video Gallery: Anyone can view, Authenticated (Admin) can add/delete
    match /gallery_videos/{videoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Bookings: Clients can create orders, Authenticated users and Admin can manage
    match /bookings/{bookingId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Users: Authenticated users can write their data, Admin can read
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Fallback match
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
